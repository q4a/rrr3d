{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "use_physx284",
      "hidden": true,
      "cacheVariables": { "RRR3D_PHYSX_VER": "284" }
    },
    {
      "name": "use_physx283",
      "hidden": true,
      "cacheVariables": { "RRR3D_PHYSX_VER": "283" }
    },
    {
      "name": "use_bullet",
      "hidden": true,
      "cacheVariables": { "RRR3D_PHYSX28_SHIM": true }
    },

    {
      "name": "msvc-x86",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-x64",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-x86-physx284-debug",
      "displayName": "MSVC x86 PhysX 2.8.4 Debug",
      "inherits": ["msvc-x86", "debug", "use_physx284"]
    },
    {
      "name": "msvc-x86-physx284-release",
      "displayName": "MSVC x86 PhysX 2.8.4 Release",
      "inherits": ["msvc-x86", "release", "use_physx284"]
    },
    {
      "name": "msvc-x86-physx283-debug",
      "displayName": "MSVC x86 PhysX 2.8.3 Debug",
      "inherits": ["msvc-x86", "debug", "use_physx283"]
    },
    {
      "name": "msvc-x86-physx283-release",
      "displayName": "MSVC x86 PhysX 2.8.3 Release",
      "inherits": ["msvc-x86", "release", "use_physx283"]
    },
    {
      "name": "msvc-x64-physx283-debug",
      "displayName": "MSVC x64 PhysX 2.8.3 Debug",
      "inherits": ["msvc-x64", "debug", "use_physx283"]
    },
    {
      "name": "msvc-x64-physx283-release",
      "displayName": "MSVC x64 PhysX 2.8.3 Release",
      "inherits": ["msvc-x64", "release", "use_physx283"]
    },
    {
      "name": "msvc-x86-bullet-debug",
      "displayName": "MSVC x86 Bullet Debug",
      "inherits": ["msvc-x86", "debug", "use_bullet"]
    },
    {
      "name": "msvc-x86-bullet-release",
      "displayName": "MSVC x86 Bullet Release",
      "inherits": ["msvc-x86", "release", "use_bullet"]
    },
    {
      "name": "msvc-x64-bullet-debug",
      "displayName": "MSVC x64 Bullet Debug",
      "inherits": ["msvc-x64", "debug", "use_bullet"]
    },
    {
      "name": "msvc-x64-bullet-release",
      "displayName": "MSVC x64 Bullet Release",
      "inherits": ["msvc-x64", "release", "use_bullet"]
    },

    {
      "name": "macos-arm64",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Debug",
      "inherits": ["macos-arm64", "debug"]
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Release",
      "inherits": ["macos-arm64", "release"]
    },
    {
      "name": "macos-arm64-asan",
      "displayName": "macOS arm64 Debug + AddressSanitizer",
      "inherits": ["macos-arm64", "debug"],
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-x86-physx284-debug", "configurePreset": "msvc-x86-physx284-debug" },
    { "name": "msvc-x86-physx284-release", "configurePreset": "msvc-x86-physx284-release" },
    { "name": "msvc-x86-physx283-debug", "configurePreset": "msvc-x86-physx283-debug" },
    { "name": "msvc-x86-physx283-release", "configurePreset": "msvc-x86-physx283-release" },
    { "name": "msvc-x64-physx283-debug", "configurePreset": "msvc-x64-physx283-debug" },
    { "name": "msvc-x64-physx283-release", "configurePreset": "msvc-x64-physx283-release" },
    { "name": "msvc-x86-bullet-debug", "configurePreset": "msvc-x86-bullet-debug" },
    { "name": "msvc-x86-bullet-release", "configurePreset": "msvc-x86-bullet-release" },
    { "name": "msvc-x64-bullet-debug", "configurePreset": "msvc-x64-bullet-debug" },
    { "name": "msvc-x64-bullet-release", "configurePreset": "msvc-x64-bullet-release" },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "macos-arm64-asan", "configurePreset": "macos-arm64-asan" }
  ]
}
