+	/// Clamp the accumulated velocity lambda and immediately undo the excess.
+	/// This is useful for legacy contact modifiers that change a constraint's
+	/// normal-force limit after the unconstrained lambda has been calculated.
+	inline bool					ClampVelocityConstraint(Body &ioBody1, Body &ioBody2, Vec3Arg inWorldSpaceAxis, float inMinLambda, float inMaxLambda)
+	{
+		float total_lambda = Clamp(mTotalLambda, inMinLambda, inMaxLambda);
+		EMotionType motion_type1 = ioBody1.GetMotionType();
+		MotionProperties *motion_properties1 = ioBody1.GetMotionPropertiesUnchecked();
+		EMotionType motion_type2 = ioBody2.GetMotionType();
+		MotionProperties *motion_properties2 = ioBody2.GetMotionPropertiesUnchecked();
+		if (motion_type1 == EMotionType::Dynamic)
+		{
+			if (motion_type2 == EMotionType::Dynamic)
+				return TemplatedSolveVelocityConstraintApplyLambda<EMotionType::Dynamic, EMotionType::Dynamic>(motion_properties1, motion_properties1->GetInverseMass(), motion_properties2, motion_properties2->GetInverseMass(), inWorldSpaceAxis, total_lambda);
+			return TemplatedSolveVelocityConstraintApplyLambda<EMotionType::Dynamic, EMotionType::Static>(motion_properties1, motion_properties1->GetInverseMass(), motion_properties2, 0.0f, inWorldSpaceAxis, total_lambda);
+		}
+		JPH_ASSERT(motion_type2 == EMotionType::Dynamic);
+		return TemplatedSolveVelocityConstraintApplyLambda<EMotionType::Static, EMotionType::Dynamic>(motion_properties1, 0.0f, motion_properties2, motion_properties2->GetInverseMass(), inWorldSpaceAxis, total_lambda);
 	}
 
